pair(key = `size`, value = $size) where {
  $size <: r"[5-9][0-9]{2}|[1-9][0-9]{3,}",
  $size <: within or { pair(key = `pageable`), pair(key = `query`) },
  register_diagnostic(
    span = $size,
    message = "Page size >= 500 fetches an unbounded page to read a few rows. Scope the request to the ids on screen (uuid_in) or paginate.",
    severity = "error"
  )
}
