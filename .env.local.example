# Local development against the self-contained backend stack (elimika repo: docker/compose.local.yaml,
# scripts/local/up.sh). Copy to .env.local, or run scripts/local-dev.sh which does it for you.
#
# Every value here is a throwaway local-only value from the elimika-local Keycloak realm
# (docker/keycloak/elimika-local-realm.json in the backend repo). Never point this file at staging.

# Backend API started by scripts/local/up.sh (bootRun, Spring profile `local`)
API_BASE_URL=http://localhost:38080

# NextAuth
AUTH_URL=http://localhost:3000
# Any random string works locally; scripts/local-dev.sh generates one into .env.local.
AUTH_SECRET=change-me-local-only-auth-secret-0123456789
AUTH_TRUST_HOST=true

# Keycloak: realm elimika-local, confidential UI client elimika-ui
KEYCLOAK_ISSUER=http://localhost:58080/realms/elimika-local
KEYCLOAK_CLIENT_ID=elimika-ui
KEYCLOAK_CLIENT_SECRET=elimika-local-ui-secret
KEYCLOAK_REALM=elimika-local

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: leave unset to use the defaults (no map preview token; public Photon place search).
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
