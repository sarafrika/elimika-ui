{
  "measuredAt": "2026-10-11",
  "unit": "uncompressed first-load JS, MiB (route-bundle-stats.json from next build)",
  "shell": { "minShare": 0.9, "budgetMB": 1.5, "targetMB": 1.25 },
  "groups": [
    {
      "name": "heavy-forms",
      "match": "/(profile(/[^/]+)?|settings|add-profile/[^/]+|account/training-center|(jobs|classes)/new|branches(/.*)?|jobs|course-management/create-new-course|courses/create-course|onboarding/[^/]+)$",
      "budgetMB": 2.4,
      "targetMB": 2.0
    },
    {
      "name": "public",
      "match": "^/(?!dashboard)",
      "budgetMB": 1.8,
      "targetMB": 1.3
    },
    {
      "name": "dashboard",
      "match": ".*",
      "budgetMB": 2.0,
      "targetMB": 1.5
    }
  ]
}
